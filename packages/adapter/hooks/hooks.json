{
  "hooks": {
    "SessionStart": [
      { "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bbs-adapter.js", "hook", "SessionStart"], "timeout": 15}] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bbs-adapter.js", "hook", "UserPromptSubmit"]}] }
    ],
    "PostToolBatch": [
      { "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bbs-adapter.js", "hook", "PostToolBatch"], "async": true}] }
    ],
    "Stop": [
      { "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bbs-adapter.js", "hook", "Stop"], "timeout": 15}] }
    ],
    "StopFailure": [
      { "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bbs-adapter.js", "hook", "StopFailure"]}] }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bbs-adapter.js", "hook", "idle_prompt"]}]
      }
    ]
  }
}
